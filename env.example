# Azure AI Foundry project endpoint
# Found on: Azure AI Foundry portal → your project → Overview
AZURE_AI_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>


# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<account>.openai.azure.com/
AZURE_OPENAI_MODEL=gpt-4.1
AZURE_EMBED_DEPLOYMENT=text-embedding-3-small

# Azure AI Search
# Endpoint: Azure portal → your Search resource → Overview
AZURE_SEARCH_ENDPOINT=https://<search-account>.search.windows.net
# Connection ID: Azure AI Foundry portal → project → Connected resources
AZURE_SEARCH_CONNECTION_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.MachineLearningServices/workspaces/<ws>/connections/uw-search
AZURE_SEARCH_INDEX_NAME=uw-guidelines

# Azure Storage Queue dispatch
# Queue names must be lowercase letters, numbers, and hyphens.
# Use AZURE_STORAGE_ACCOUNT_NAME with DefaultAzureCredential, or set
# AZURE_STORAGE_CONNECTION_STRING to use an account key/SAS connection string.
AZURE_STORAGE_ACCOUNT_NAME=uwriskagentstorage
# AZURE_STORAGE_CONNECTION_STRING=
UW_ACCEPT_QUEUE=uw-decisions-accept
UW_REFER_QUEUE=uw-decisions-refer
UW_DECLINE_QUEUE=uw-decisions-decline
UW_QUEUE_RAW_OUTPUT_MAX_CHARS=20000

# MCP risk tools server (all four tools in one server)
MCP_RISK_SERVER_URL=http://127.0.0.1:8001/mcp

APPLICATIONINSIGHTS_CONNECTION_STRING=

# Underwriting API service
# Which LLM drives the agent loop: azure | ollama
#   azure   Azure AI Foundry, AZURE_OPENAI_MODEL (gpt-4.1)
#   ollama  Local/remote Ollama, OLLAMA_MODEL on OLLAMA_HOST
UW_LLM_PROVIDER=azure
# Set true to return random ACCEPT, DECLINE, or REFER decisions without an LLM.
MOCK_DECISION=false

# Ollama settings (used when UW_LLM_PROVIDER=ollama)
OLLAMA_HOST=http://192.168.2.250:11434
OLLAMA_MODEL=llama3.1:8b
UW_API_URL=http://127.0.0.1:8010
